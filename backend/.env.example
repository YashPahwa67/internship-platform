# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas (required) — https://cloud.mongodb.com
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/internship_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/internship_platform?retryWrites=true&w=majority

# JWT (use strong random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary — https://cloudinary.com (resumes & profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=imp

# Upload limits (MB)
MAX_PROFILE_IMAGE_MB=2
MAX_RESUME_MB=5
