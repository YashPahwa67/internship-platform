# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Production: https://your-domain.com (must match browser URL)
# ALLOWED_ORIGINS=https://your-domain.com

# Redis — use Upstash in production (Render cannot run local Redis)
# Upstash console → your database → Connect → copy TCP URL (must start with rediss://)
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
# Or use Upstash's variable name (either works):
# UPSTASH_REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379

# MongoDB Atlas (required) — https://cloud.mongodb.com
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/internship_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/internship_platform?retryWrites=true&w=majority

# JWT (use strong random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary — https://cloudinary.com (resumes & profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=imp

# Upload limits (MB)
MAX_PROFILE_IMAGE_MB=2
MAX_RESUME_MB=5

# ── Gmail SMTP (required for real email delivery) ────────────────────────────
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
#    (Select "Mail" → Generate → copy the 16-char password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=your@gmail.com
# If not configured, OTP emails are captured by Ethereal (preview URL in terminal).
